{%- comment -%} Greenform — Gifting band. Image background with overlaid text. {%- endcomment -%}
{%- assign sid = 'gf-gift-' | append: section.id -%}
<style>
  #{{ sid }} { padding: 40px 0; }
  #{{ sid }} .gfg-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  #{{ sid }} .gfg-band { position: relative; color: #fff; text-align: center; border-radius: 12px; overflow: hidden; background: #16331a; }
  #{{ sid }} .gfg-bg { position: absolute; inset: 0; }
  #{{ sid }} .gfg-bg img { width: 100%; height: 100%; object-fit: cover; opacity: {{ section.settings.image_opacity | divided_by: 100.0 }}; }
  #{{ sid }} .gfg-in { position: relative; padding: 66px 24px; }
  #{{ sid }} .gfg-eyebrow { font-family: var(--font-display, 'Advercase', Georgia, serif); font-size: 14px; opacity: .9; margin-bottom: 8px; }
  #{{ sid }} .gfg-in h2 { font-size: clamp(24px, 3.2vw, 36px); font-weight: 600; margin-bottom: 12px; }
  #{{ sid }} .gfg-in p { max-width: 500px; margin: 0 auto 22px; opacity: .92; }
  #{{ sid }} .gfg-btn { display: inline-block; font-weight: 500; font-size: 15px; padding: 15px 30px;
    border-radius: 8px; background: #fff; color: var(--accent, #2d4a2d); transition: opacity .18s; }
  #{{ sid }} .gfg-btn:hover { opacity: .9; }
</style>
<div id="{{ sid }}">
  <div class="gfg-wrap">
    <div class="gfg-band">
      <div class="gfg-bg">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="" loading="lazy" width="1600" height="700">
        {%- endif -%}
      </div>
      <div class="gfg-in">
        {%- if section.settings.eyebrow != blank -%}<div class="gfg-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="gfg-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Gifting band",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "image_opacity", "label": "Image opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A living gift" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifting, made easy" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "For housewarmings, birthdays and thank-yous, delivered with a handwritten note and care card." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Gifting band" }]
}
{% endschema %}
