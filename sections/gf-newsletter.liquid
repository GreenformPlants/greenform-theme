{%- comment -%} Greenform — Newsletter signup. Uses Shopify customer form. {%- endcomment -%}
{%- assign sid = 'gf-news-' | append: section.id -%}
<style>
  #{{ sid }} { padding: 64px 0; background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; text-align: center; }
  #{{ sid }} .gfnl-wrap { max-width: 560px; margin: 0 auto; padding: 0 24px; }
  #{{ sid }} .gfnl-wrap h2 { font-size: clamp(22px, 3vw, 32px); font-weight: 600; margin-bottom: 10px; }
  #{{ sid }} .gfnl-wrap p { opacity: .85; margin-bottom: 24px; }
  #{{ sid }} .gfnl-form { display: flex; gap: 10px; max-width: 440px; margin: 0 auto; }
  #{{ sid }} .gfnl-form input[type="email"] { flex: 1; border: none; border-radius: 8px; padding: 14px 18px; font-size: 15px; }
  #{{ sid }} .gfnl-btn { font-weight: 500; font-size: 15px; padding: 14px 26px; border: none; border-radius: 8px;
    background: {{ section.settings.button_bg }}; color: {{ section.settings.button_fg }}; cursor: pointer; transition: opacity .18s; }
  #{{ sid }} .gfnl-btn:hover { opacity: .9; }
  #{{ sid }} .gfnl-note { margin-top: 14px; font-size: 13px; opacity: .9; }
  @media (max-width: 560px){ #{{ sid }} .gfnl-form { flex-direction: column; } }
</style>
<div id="{{ sid }}">
  <div class="gfnl-wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="gfnl-form">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" aria-label="Email" required>
        <button type="submit" class="gfnl-btn">{{ section.settings.button_label }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="gfnl-note">{{ section.settings.success_message }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Care tips, new arrivals, and the occasional restock of something special." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing. Check your inbox." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2d4a2d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_fg", "label": "Button text", "default": "#2d4a2d" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
