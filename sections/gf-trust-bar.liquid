{%- comment -%} Greenform — Trust bar. Thin strip of reassurances. {%- endcomment -%}
{%- assign sid = 'gf-trust-' | append: section.id -%}
{%- assign cols = section.blocks.size -%}
<style>
  #{{ sid }} { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; }
  #{{ sid }} .gftb { max-width: 1180px; margin: 0 auto; padding: 22px 24px;
    display: grid; grid-template-columns: repeat({{ cols }}, 1fr); gap: 16px; }
  #{{ sid }} .gftb-i { display: flex; align-items: center; justify-content: center; gap: 11px;
    font-size: 13.5px; font-weight: 500; text-align: left; }
  #{{ sid }} .gftb-i svg { flex: none; opacity: .9; }
  @media (max-width: 820px){ #{{ sid }} .gftb { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
</style>
<div id="{{ sid }}">
  <div class="gftb">
    {%- for block in section.blocks -%}
      <div class="gftb-i" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'shield' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5l-8-3z"/><path d="M9 12l2 2 4-4"/></svg>
          {%- when 'truck' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 13h13V6H3zM16 8h3l2 3v2h-5z"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17.5" cy="17.5" r="1.7"/></svg>
          {%- when 'check' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M8 12l2.5 2.5L16 9"/></svg>
          {%- when 'chat' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.4A8.5 8.5 0 1 1 21 11.5z"/></svg>
          {%- when 'leaf' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M11 20A7 7 0 0 1 4 13C4 8 11 4 20 4c0 9-4 16-9 16z"/><path d="M4 20c2-4 5-7 9-9"/></svg>
        {%- endcase -%}
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2d4a2d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
        "options": [
          { "value": "shield", "label": "Shield" },
          { "value": "truck", "label": "Truck" },
          { "value": "check", "label": "Check" },
          { "value": "chat", "label": "Chat" },
          { "value": "leaf", "label": "Leaf" }
        ]},
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $99" }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Trust bar", "blocks": [
    { "type": "item", "settings": { "icon": "shield", "text": "30-day arrival guarantee" } },
    { "type": "item", "settings": { "icon": "truck", "text": "Free shipping over $99" } },
    { "type": "item", "settings": { "icon": "check", "text": "Hand-picked the morning it ships" } },
    { "type": "item", "settings": { "icon": "chat", "text": "Care support after you buy" } }
  ]}]
}
{% endschema %}
