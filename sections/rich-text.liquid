<div class="rich-text">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.body != blank -%}
    <p>{{ section.settings.body }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "heading", "label": "Heading", "default": "About Greenform" },
    { "type": "textarea", "id": "body",    "label": "Body" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
