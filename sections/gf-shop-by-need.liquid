{%- comment -%} Greenform — Shop by need. Discovery tiles (light, room, size, difficulty, pet). {%- endcomment -%}
{%- assign sid = 'gf-need-' | append: section.id -%}
{%- assign cols = section.blocks.size -%}
<style>
  #{{ sid }} { padding: 64px 0; background: {{ section.settings.bg_color }}; }
  #{{ sid }} .gfn-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  #{{ sid }} .gfn-head { text-align: center; max-width: 640px; margin: 0 auto 34px; }
  #{{ sid }} .gfn-eyebrow { font-family: var(--font-display, 'Advercase', Georgia, serif);
    font-size: 14px; color: var(--accent, #2d4a2d); margin-bottom: 8px; }
  #{{ sid }} .gfn-head h2 { font-size: clamp(24px, 3.2vw, 36px); font-weight: 600; letter-spacing: -.01em; }
  #{{ sid }} .gfn-head p { color: var(--mid, #6b6b6b); margin-top: 10px; }
  #{{ sid }} .gfn-grid { display: grid; grid-template-columns: repeat({{ cols }}, 1fr); gap: 14px; }
  #{{ sid }} .gfn-tile { background: #fff; border: 1px solid var(--line, #d8d8d8); border-radius: 10px;
    padding: 24px 16px; text-align: center; transition: transform .2s, box-shadow .2s; display: block; }
  #{{ sid }} .gfn-tile:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(0,0,0,.07); }
  #{{ sid }} .gfn-ic { width: 44px; height: 44px; border-radius: 50%; background: var(--accent-light, #e8f0e8);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; color: var(--accent, #2d4a2d); }
  #{{ sid }} .gfn-tile h3 { font-size: 14px; font-weight: 600; margin-bottom: 3px; }
  #{{ sid }} .gfn-tile p { font-size: 12px; color: var(--mid, #6b6b6b); }
  @media (max-width: 1024px){ #{{ sid }} .gfn-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
<div id="{{ sid }}">
  <div class="gfn-wrap">
    <div class="gfn-head">
      {%- if section.settings.eyebrow != blank -%}<div class="gfn-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
    <div class="gfn-grid">
      {%- for block in section.blocks -%}
        <a class="gfn-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="gfn-ic">
            {%- case block.settings.icon -%}
              {%- when 'sun' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg>
              {%- when 'home' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 10 12 3l9 7"/><path d="M5 9v11h14V9"/></svg>
              {%- when 'ruler' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20h16M7 20V8M12 20V4M17 20v-8"/></svg>
              {%- when 'drop' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2C7 8 7 12 7 14a5 5 0 0 0 10 0c0-2 0-6-5-12z"/></svg>
              {%- when 'paw' -%}<svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="10" r="5"/><path d="M5 21c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5"/></svg>
            {%- endcase -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Shop by need",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your plant" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by need" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Start from the question you are actually asking." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#e8f0e8" }
  ],
  "blocks": [
    { "type": "need", "name": "Need", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sun",
        "options": [
          { "value": "sun", "label": "Sun (light)" },
          { "value": "home", "label": "Home (room)" },
          { "value": "ruler", "label": "Ruler (size)" },
          { "value": "drop", "label": "Drop (difficulty)" },
          { "value": "paw", "label": "Paw (pet-friendly)" }
        ]},
      { "type": "text", "id": "title", "label": "Title", "default": "By light" },
      { "type": "text", "id": "text", "label": "Subtext", "default": "Low, medium, bright" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Shop by need", "blocks": [
    { "type": "need", "settings": { "icon": "sun", "title": "By light", "text": "Low, medium, bright" } },
    { "type": "need", "settings": { "icon": "home", "title": "By room", "text": "Living, bedroom, bath" } },
    { "type": "need", "settings": { "icon": "ruler", "title": "By size", "text": "Desktop to statement" } },
    { "type": "need", "settings": { "icon": "drop", "title": "By difficulty", "text": "Beginner to devoted" } },
    { "type": "need", "settings": { "icon": "paw", "title": "Pet-friendly", "text": "Safe for cats and dogs" } }
  ]}]
}
{% endschema %}
