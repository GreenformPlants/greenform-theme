{%- paginate collection.products by 24 -%}

{% render 'breadcrumb' %}

<div class="page-header">
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <p>{{ collection.description | strip_html | truncatewords: 50 }}</p>
  {%- endif -%}
</div>

<div class="product-grid-wrap">
  {%- if collection.products.size > 0 -%}
    <div class="product-grid">
      {%- for card_product in collection.products -%}
        {% render 'product-card', card_product: card_product %}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="margin-top:32px; display:flex; gap:12px; justify-content:center; font-size:13px;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- else -%}
    <p style="color: var(--mid); font-size: 14px;">{{ 'collection.empty' | t }}</p>
  {%- endif -%}
</div>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": []
}
{% endschema %}
