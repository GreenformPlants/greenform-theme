<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Geologica:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
      :root {
        --font: 'Inter', {{ settings.font_stack }};
        --font-serif: 'Fraunces', Georgia, 'Times New Roman', serif;
        --black: {{ settings.color_black }};
        --mid: {{ settings.color_mid }};
        --light: {{ settings.color_light }};
        --bg: {{ settings.color_bg }};
        --white: {{ settings.color_white }};
        --accent: {{ settings.color_accent }};
        --accent-light: {{ settings.color_accent_light }};
        --max-width: {{ settings.max_width }}px;
      }
    </style>

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'greenform.css' | asset_url | stylesheet_tag }}
    {{ 'pdp.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <style>
      .product-card-spinner{position:relative;aspect-ratio:1/1;overflow:hidden;background:#fff;cursor:ew-resize;touch-action:pan-y;user-select:none}
      .product-card-frame{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;pointer-events:none}
      .product-card-frame.is-active{opacity:1}
      .product-card-spinner-badge,.product-card-spinner-hint{position:absolute;background:rgba(29,29,31,0.6);color:#fff;border-radius:100px;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;padding:4px 9px;opacity:0;transition:opacity .25s ease;pointer-events:none;z-index:2}
      .product-card-spinner-badge{top:12px;left:12px;font-weight:700;letter-spacing:0.12em}
      .product-card-spinner-hint{bottom:12px;left:50%;transform:translateX(-50%);padding:5px 11px}
      .product-card-spinner:hover .product-card-spinner-badge,.product-card-spinner:hover .product-card-spinner-hint{opacity:1}
      .product-card-sizes{font-size:13px;color:var(--mid,#6e6e73);margin-top:4px;font-variant-numeric:tabular-nums}
      @media (prefers-reduced-motion: reduce){.product-card-spinner{cursor:default}}
    </style>
  </head>

  <body class="template-{{ template | split: '.' | first | handle }}">
    <a class="skip-link" href="#main-content">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script>
      window.Greenform = {
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_url: '{{ routes.cart_url }}',
          search_url: '{{ routes.search_url }}'
        },
        shop: {
          currency: {{ shop.currency | json }},
          moneyFormat: {{ shop.money_format | json }}
        }
      };
    </script>

    <script>
      (function(){
        if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
        function build(stage){
          if(stage.dataset.spinnerReady)return;
          stage.dataset.spinnerReady='1';
          var raw=stage.getAttribute('data-frames');if(!raw)return;
          var frames;try{frames=JSON.parse(raw);}catch(e){return;}
          if(!frames||frames.length<2)return;
          var staticImg=stage.querySelector('img[data-static]');if(!staticImg)return;
          var imgs=[staticImg];
          for(var i=1;i<frames.length;i++){
            var im=document.createElement('img');im.alt='';im.draggable=false;im.className='product-card-frame';im.dataset.frame=i;
            stage.insertBefore(im,staticImg.nextSibling);imgs.push(im);
          }
          staticImg.dataset.frame='0';
          var loaded=false,rect=null,activeIdx=0,hovering=false;
          function preload(){if(loaded)return;loaded=true;for(var i=1;i<frames.length;i++){if(!imgs[i].src)imgs[i].src=frames[i];}}
          function setFrame(idx){if(idx<0)idx=0;if(idx>=frames.length)idx=frames.length-1;if(idx===activeIdx)return;imgs[activeIdx].classList.remove('is-active');imgs[idx].classList.add('is-active');activeIdx=idx;}
          function refreshRect(){rect=stage.getBoundingClientRect();}
          function onMove(e){if(!hovering)return;if(!rect)refreshRect();var x=(e.touches?e.touches[0].clientX:e.clientX)-rect.left;var r=x/rect.width;if(r<0)r=0;if(r>0.9999)r=0.9999;setFrame(Math.floor(r*frames.length));}
          function onEnter(){hovering=true;refreshRect();preload();}
          function onLeave(){hovering=false;setFrame(0);}
          stage.addEventListener('mouseenter',onEnter);
          stage.addEventListener('mousemove',onMove);
          stage.addEventListener('mouseleave',onLeave);
          stage.addEventListener('touchstart',function(e){onEnter();onMove(e);},{passive:true});
          stage.addEventListener('touchmove',function(e){onMove(e);},{passive:true});
          stage.addEventListener('touchend',onLeave);
          stage.addEventListener('touchcancel',onLeave);
          window.addEventListener('resize',function(){rect=null;});
          window.addEventListener('scroll',function(){rect=null;},{passive:true});
        }
        function init(root){(root||document).querySelectorAll('[data-spinner]').forEach(build);}
        if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){init();});}else{init();}
        document.addEventListener('shopify:section:load',function(e){init(e.target);});
      })();
    </script>
  </body>
</html>
